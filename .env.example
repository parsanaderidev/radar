# ==============================================================================
# AI Lead Radar — Environment Configuration Reference Template
# Designed for Iran Operational Environment (Zero Foreign Cloud Lock-in)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PocketBase Backend (Self-Hosted on Domestic Server / Localhost)
# ------------------------------------------------------------------------------
# Internal server URL where Next.js backend and worker scripts reach PocketBase
POCKETBASE_URL=http://127.0.0.1:8090

# Public URL used by browser client for real-time SSE subscriptions
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials for schema migrations and admin operations
POCKETBASE_ADMIN_EMAIL=admin@radar.local

# SECURITY: Set a strong, unique password in production (minimum 16 characters).
POCKETBASE_ADMIN_PASSWORD=change_this_to_a_secure_admin_password_min_16_chars

# Dashboard dedicated login password (/login). Falls back to POCKETBASE_ADMIN_PASSWORD.
RADAR_ADMIN_PASSWORD=change_this_to_a_secure_dashboard_password_min_16_chars

# Cryptographic secret for signing HMAC session cookies (generate: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_secure_random_64_character_hex_secret_here

# ------------------------------------------------------------------------------
# 2. Programmatic API Access & Webhook Secrets
# ------------------------------------------------------------------------------
# Bearer API Key for worker scripts, cron jobs, and external automation pipelines
RADAR_API_KEY=generate_a_random_32_byte_hex_token_here

# Telegram Group Bot Webhook (POST /api/ingest/telegram)
# Setup: https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/api/ingest/telegram&secret_token=<SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate_a_random_32_byte_hex_token_here

# Bale Bot API Webhook (POST /api/ingest/bale)
# Mirrors Telegram update schema via tapi.bale.ai
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=generate_a_random_32_byte_hex_token_here

# ------------------------------------------------------------------------------
# 3. LLM Gateway & AI Connectivity
# ------------------------------------------------------------------------------
# Option A: Local Ollama / vLLM (Default zero-cloud setup)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=dummy
#   LLM_MODEL=llama3.1
#
# Option B: Cloud OpenRouter (For development or hosted inference)
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   OPENROUTER_API_KEY=sk-or-v1-...
#   LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dummy
OPENROUTER_API_KEY=
LLM_MODEL=llama3.1

# ------------------------------------------------------------------------------
# 4. Token Cost Calculation Parameters (USD per 1 Million Tokens)
# ------------------------------------------------------------------------------
INPUT_TOKEN_COST_PER_MILLION=0.15
OUTPUT_TOKEN_COST_PER_MILLION=0.60

