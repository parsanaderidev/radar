# ==========================================
# AI Lead Radar - Environment Configuration
# Designed for Iran Operational Environment (Zero Foreign Cloud Lock-in)
# ==========================================

# PocketBase Backend (Self-Hosted on Domestic Server / Localhost)
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@leadradar.local
# SECURITY: Set a strong, unique password in production (minimum 16 characters). Never commit secrets.
POCKETBASE_ADMIN_PASSWORD=change_this_to_a_secure_admin_password_min_16_chars

# Optional Programmatic API Key for Worker / External Ingestion Webhooks
RADAR_API_KEY=generate_a_random_32_byte_hex_token_here

# LLM Connectivity (Supports local Ollama, vLLM, or domestic OpenAI-compatible AI Gateways)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=dummy
LLM_MODEL=llama3.1

# Cost Calculation Parameters (USD per 1 Million Tokens)
INPUT_TOKEN_COST_PER_MILLION=0.15
OUTPUT_TOKEN_COST_PER_MILLION=0.60
